{
  "name": "product-graph-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test:responsive": "tsc -p tsconfig.visual.json && playwright test --config=playwright.responsive.config.ts",
    "test:visual": "tsc -p tsconfig.visual.json && playwright test",
    "test:visual:update": "tsc -p tsconfig.visual.json && playwright test --update-snapshots",
    "preview": "vite preview",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && npm run build:lib:css",
    "build:lib:css": "node scripts/gen-safelist.mjs && tailwindcss -i src/design-system.lib.css -o dist-lib/styles.css --minify && cp src/fonts/*.woff2 dist-lib/",
    "preview:ds": "npm run build:lib && vite -c preview/vite.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@shadcn/react": "^0.3.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "react-grab": "^0.1.50",
    "skills": "^1.5.22",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/components/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/components/ui/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/styles.css"
  }
}
